table dim_date
	lineageTag: 560dbebc-8acb-4533-86e7-90075d4d2edc
	dataCategory: Time

	column month
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 036ca128-7752-4539-8a87-9bc3b16ce625
		summarizeBy: none
		sourceColumn: month

	column year
		dataType: int64
		formatString: 0
		lineageTag: bb4cda9d-ab75-42ca-b905-ebd9f193e0d6
		summarizeBy: none
		sourceColumn: year

	column month_number
		dataType: int64
		formatString: 0
		lineageTag: 935cb558-ed83-4eac-8ab9-69f9217819b5
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		lineageTag: faa0dd6c-0f99-433f-b9b4-d1369c9ea6db
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_number

	column quarter
		dataType: string
		lineageTag: 812e2f10-04a1-4900-ac04-dc552ac5d04d
		summarizeBy: none
		sourceColumn: quarter

	column year_month
		dataType: string
		lineageTag: 99534975-7b66-406c-b4c5-f5f92bb23172
		summarizeBy: none
		sourceColumn: year_month

	column season
		dataType: string
		lineageTag: a7defee8-1c8a-4855-9259-c9002e0fff40
		summarizeBy: none
		sourceColumn: season

	partition dim_date = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"month", type date}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"month_name", type text}, {"quarter", type text}, {"year_month", type text}, {"season", type text}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
