	partition fact_route_month = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\fact_route_month.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"route_id", Int64.Type}, {"month", type date}, {"trains_planned", Int64.Type}, {"trains_cancelled", Int64.Type}, {"trains_run", Int64.Type}, {"late_departures", Int64.Type}, {"late_arrivals", Int64.Type}, {"late_over_15", Int64.Type}, {"late_over_30", Int64.Type}, {"late_over_60", Int64.Type}, {"avg_delay_late_trains_min", type number}, {"total_delay_minutes", Int64.Type}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
