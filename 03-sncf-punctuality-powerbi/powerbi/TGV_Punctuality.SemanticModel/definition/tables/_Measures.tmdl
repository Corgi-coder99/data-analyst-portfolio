table _Measures
	lineageTag: a3b532ac-1060-4cc0-ba80-ee4e6c328506

	column Dummy
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 47244141-bbaa-4e27-a55d-999e4697b7fe
		summarizeBy: none
		sourceColumn: Dummy

	measure 'Trains Planned' = SUM ( fact_route_month[trains_planned] )
		formatString: #,0
		lineageTag: d55d50a0-cfab-4a01-950f-157a5b07c183

	measure 'Trains Cancelled' = SUM ( fact_route_month[trains_cancelled] )
		formatString: #,0
		lineageTag: aefa78f4-244c-4e3c-8236-45f4d99c3b97

	measure 'Trains Run' = SUM ( fact_route_month[trains_run] )
		formatString: #,0
		lineageTag: 0cce6e81-b660-4bd3-b2f0-38e3035e6a01

	measure 'Late Arrivals' = SUM ( fact_route_month[late_arrivals] )
		formatString: #,0
		lineageTag: 776d207d-43aa-4e4c-b6f0-ca5128d70282

	measure 'Late Over 15' = SUM ( fact_route_month[late_over_15] )
		formatString: #,0
		lineageTag: f78fe382-299b-4897-b11e-f61ee6bb7f53

	measure 'Late Over 30' = SUM ( fact_route_month[late_over_30] )
		formatString: #,0
		lineageTag: 4c3eccc4-2e3c-4362-a106-981b484ef68e

	measure 'Late Over 60' = SUM ( fact_route_month[late_over_60] )
		formatString: #,0
		lineageTag: 54a0c0f5-c392-4160-83ed-ee3f128709a9

	measure 'Total Delay Minutes' = SUM ( fact_route_month[total_delay_minutes] )
		formatString: #,0
		lineageTag: 8a249679-793c-4b57-aeff-8c0f76dade2c

	measure 'On Time Trains' = [Trains Run] - [Late Arrivals]
		formatString: #,0
		lineageTag: ba925653-f26a-4414-b911-664e7b2b3e1f

	measure 'Cancellation Rate' = DIVIDE ( [Trains Cancelled], [Trains Planned] )
		formatString: 0.0%
		lineageTag: 4a5970c1-be5b-4644-8685-54c036c9578f

	measure 'Late Arrival Rate' = DIVIDE ( [Late Arrivals], [Trains Run] )
		formatString: 0.0%
		lineageTag: 0046c049-105e-4c1d-adb5-0cdda3ec29c1

	measure 'Over 30 Rate' = DIVIDE ( [Late Over 30], [Trains Run] )
		formatString: 0.0%
		lineageTag: 9dbecca7-a042-41f7-8252-6adc277c655a

	measure 'Over 60 Rate' = DIVIDE ( [Late Over 60], [Trains Run] )
		formatString: 0.0%
		lineageTag: 0043b726-c472-4539-a5aa-1ce04a3a7497

	measure 'On Time Rate' = DIVIDE ( [On Time Trains], [Trains Run] )
		formatString: 0.0%
		lineageTag: a693d6c9-3878-4bf6-b0be-c2eebd19bebc

	measure 'Avg Delay of Late Trains (min)' = DIVIDE ( [Total Delay Minutes], [Late Arrivals] )
		formatString: 0.0
		lineageTag: 8fb4430d-0bbb-4b6c-9632-1a79700e92b3

	measure 'Total Delay Hours' = DIVIDE ( [Total Delay Minutes], 60 )
		formatString: #,0
		lineageTag: 0a0e9731-12aa-4638-8403-ef4a64cb5930

	measure 'Late Rate Last Year' =
			VAR _prior =
			    SELECTCOLUMNS ( VALUES ( dim_date[month] ), "m", EDATE ( dim_date[month], -12 ) )
			RETURN
			    CALCULATE ( [Late Arrival Rate], REMOVEFILTERS ( dim_date ), TREATAS ( _prior, dim_date[month] ) )
		formatString: 0.0%
		lineageTag: f9246776-7717-4b23-a563-d8b50625d730

	measure 'Late Rate YoY Change (pts)' = [Late Arrival Rate] - [Late Rate Last Year]
		formatString: +0.0%;-0.0%
		lineageTag: 7bb969a0-2631-44e0-9a2e-7f2111332d99

	measure 'Late Trains by Cause' = SUM ( fact_delay_cause[late_trains_est] )
		formatString: #,0
		lineageTag: 028d5feb-38e6-493c-96d3-2a05a87f3366

	measure 'Cause Share' =
			DIVIDE (
			    [Late Trains by Cause],
			    CALCULATE ( [Late Trains by Cause], ALL ( fact_delay_cause[cause] ) )
			)
		formatString: 0.0%
		lineageTag: d2f86262-b469-4d55-bd3c-cbb0f382583a

	measure 'Late Rate Rank (routes with 2,000+ trains)' =
			IF (
			    [Trains Run] >= 2000,
			    RANKX (
			        FILTER ( ALLSELECTED ( dim_route[route] ), [Trains Run] >= 2000 ),
			        [Late Arrival Rate], , DESC, DENSE
			    )
			)
		formatString: 0
		lineageTag: 3e7966c1-9c37-41ba-83f6-44511d6e02e8

	measure 'Selected Axis' = SELECTEDVALUE ( dim_route[axis], "All axes" )
		lineageTag: e903be41-13b2-4257-8b96-5a032fae3c97

	measure Headline = "Late-arrival rate " & FORMAT ( [Late Arrival Rate], "0.0%" ) & " | " & [Selected Axis]
		lineageTag: d406088b-18b8-4e3d-ab6f-ceb0c389c2ad

	measure 'Late Rate Colour' =
			SWITCH (
			    TRUE (),
			    [Late Arrival Rate] >= 0.18, "#C60C30",
			    [Late Arrival Rate] >= 0.14, "#E8A33D",
			    "#1B8A8F"
			)
		lineageTag: 364ebf52-8207-4948-a155-542c53e1bf49

	measure 'Outcome Trains' =
			SWITCH (
			    SELECTEDVALUE ( Outcome[Outcome] ),
			    "On time", [On Time Trains],
			    "Late, under 15 min", [Late Arrivals] - [Late Over 15],
			    "Late 15 to 30 min", [Late Over 15] - [Late Over 30],
			    "Late 30 to 60 min", [Late Over 30] - [Late Over 60],
			    "Late over 60 min", [Late Over 60],
			    "Cancelled", [Trains Cancelled]
			)
		formatString: #,0
		lineageTag: bb619ec8-93c0-48fc-8df7-932561139470

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table [Dummy = Int64.Type], {{1}})
				in
					Source
