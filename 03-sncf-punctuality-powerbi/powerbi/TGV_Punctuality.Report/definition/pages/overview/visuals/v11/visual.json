{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "v11",
  "position": {
    "x": 240,
    "y": 170,
    "z": 11,
    "height": 260,
    "width": 510,
    "tabOrder": 1100
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month"
                }
              },
              "queryRef": "dim_date.month",
              "nativeQueryRef": "month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Late Arrival Rate"
                }
              },
              "queryRef": "_Measures.Late Arrival Rate",
              "nativeQueryRef": "Late Arrival Rate"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Late-arrival rate'"
                }
              }
            }
          }
        }
      ]
    }
  }
}