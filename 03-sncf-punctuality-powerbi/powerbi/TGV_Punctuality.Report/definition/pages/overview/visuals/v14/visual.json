{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "v14",
  "position": {
    "x": 760,
    "y": 440,
    "z": 14,
    "height": 270,
    "width": 500,
    "tabOrder": 1400
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Outcome"
                    }
                  },
                  "Property": "Outcome"
                }
              },
              "queryRef": "Outcome.Outcome",
              "nativeQueryRef": "Outcome"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Outcome Trains"
                }
              },
              "queryRef": "_Measures.Outcome Trains",
              "nativeQueryRef": "Outcome Trains"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'What happened to every planned train'"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "labels": [
        {
          "properties": {
            "labelStyle": {
              "expr": {
                "Literal": {
                  "Value": "'Percent of total'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "10D"
                }
              }
            }
          }
        }
      ]
    }
  }
}